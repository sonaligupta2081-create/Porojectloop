# --- Server-only secrets. Never import these into client components. ---
# Copy to .env.local and fill in real values. .env.local is gitignored.

# Pooled connection string (use for the running app, e.g. Neon's pgbouncer URL)
DATABASE_URL="your_database_url"

# Direct (non-pooled) connection string, used only for running migrations
DIRECT_URL="your_direct_database_url"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# Server-side only — never reference in client components or expose via NEXT_PUBLIC_*
ANTHROPIC_API_KEY="sk-ant-..."

# Used by lib/search.ts for embeddings (pgvector similarity search that
# powers Ask LOOP and theme matching). This variable existed in
# lib/search.ts but was missing from every .env.example in the original
# project — without it, /api/insights fails at runtime with a clear
# "VOYAGE_API_KEY is not configured" error instead of silently doing
# nothing, but it's easy to miss until you hit that error.
VOYAGE_API_KEY="your_voyage_api_key"
